# Maintainer: Diego Esparza <diegoisaiuwu at gmail dot com>
pkgname=pulso
pkgver=0.1.0beta2
_tag=v0.1.0-beta2
pkgrel=1
pkgdesc="Monitor de recursos por aplicación: memoria real (PSS), CPU, GPU NVIDIA, disco y red"
arch=('any')
url="https://github.com/ARIOT117/pulso"
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'iproute2')
optdepends=('nvidia-utils: uso de GPU y VRAM por aplicación en tarjetas NVIDIA')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "$pkgname-${_tag#v}"
  ./packaging/install-files.sh "$pkgdir"
  python -m compileall -q -d /usr/lib/pulso -o 0 -o 1 "$pkgdir/usr/lib/pulso"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
